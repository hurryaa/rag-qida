# FastGPT API 配置
# ==========================================

# 管理员 Key（用于创建知识库和上传文件）
# 对应 curl 中的 fastgpt-gcFmV... 开头的 Key
FASTGPT_ADMIN_KEY=your-admin-key-here

# 聊天 App Key（用于对话功能）
# 对应 curl 中的 fastgpt-m06FYV... 开头的 Key
FASTGPT_CHAT_APP_KEY=your-chat-app-key-here

# FastGPT 服务地址
FASTGPT_BASE_URL=https://fastgpt.aiown.top
